---
import ArticleBody from "./ArticleBody.astro";
import ArticleFooter from "./ArticleFooter.astro";
import ArticleHeader from "./ArticleHeader.astro";
import Breadcrumb from "./Breadcrumb.astro";

interface Props {
  post: any;
  sectionLabel: string;
  listHref: string;
  previousPost?: any;
  nextPost?: any;
  hasBody?: boolean;
}

const { post, sectionLabel, listHref, previousPost, nextPost, hasBody = true } = Astro.props;
---

<article class="article-page">
  <div class="container">
    <div class="article-shell">
      <Breadcrumb
        items={[
          { label: "홈", href: import.meta.env.BASE_URL },
          { label: sectionLabel, href: listHref },
          { label: post.data.title }
        ]}
      />

      <ArticleHeader post={post} />

      {hasBody && (
        <ArticleBody>
          <slot />
        </ArticleBody>
      )}

      {post.data.attachments?.length > 0 && (
        <section class="article-attachments" aria-labelledby="attachments-heading">
          <h2 id="attachments-heading">첨부파일</h2>
          <ul>
            {post.data.attachments.map((attachment: { name: string; url: string }) => (
              <li><a href={attachment.url} download>{attachment.name}</a></li>
            ))}
          </ul>
        </section>
      )}

      <ArticleFooter
        tags={post.data.tags}
        listHref={listHref}
        previousPost={previousPost}
        nextPost={nextPost}
      />
    </div>
  </div>
</article>
