---
interface Props {
  tags: string[];
  label?: string;
  linked?: boolean;
}

import { getTagUrl } from "../utils/content";
const { tags, label = "태그", linked = true } = Astro.props;
---

{tags?.length > 0 && (
  <div class="tag-list" aria-label={label}>
    {tags.map((tag) => linked ? <a class="tag-badge" href={getTagUrl(tag)}>#{tag}</a> : <span class="tag-badge">#{tag}</span>)}
  </div>
)}
