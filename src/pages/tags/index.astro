---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getTagUrl } from "../../utils/content";
const posts = [...await getCollection("notices", ({ data }) => !data.draft), ...await getCollection("activities", ({ data }) => !data.draft)];
const tags = [...posts.reduce((counts, post) => { post.data.tags.forEach((tag) => counts.set(tag, (counts.get(tag) ?? 0) + 1)); return counts; }, new Map<string, number>())]
  .map(([name, count]) => ({ name, count })).sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, "ko"));
---
<BaseLayout title="태그" description="주제별로 Altibase 노동조합 게시물을 찾아보세요.">
  <section class="page-header"><div class="container"><h1>주제별 게시물</h1><p>관심 있는 태그를 선택하면 공지사항과 활동보고를 함께 확인할 수 있습니다.</p></div></section>
  <section class="section-pad"><div class="container"><div class="tag-directory">{tags.map((tag) => (
    <a class="tag-directory-link" href={getTagUrl(tag.name)}><span>#{tag.name}</span><strong>{tag.count}건</strong></a>
  ))}</div></div></section>
</BaseLayout>
